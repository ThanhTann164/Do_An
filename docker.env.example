# Docker Environment Variables Example
# Copy this file to .env and adjust values as needed
# docker-compose.yml will use these variables

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smarthome
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_PORT=3307

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Backend Configuration
NODE_ENV=production
PORT=3001
BACKEND_PORT=3002

# Database Connection (for backend service)
# Note: DB_HOST is set to 'mysql' (service name) in docker-compose.yml
# These are defaults, actual values come from docker-compose environment
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smarthome
DB_USER=appuser
DB_PASSWORD=apppassword

# Redis Connection (for backend service)
# Note: REDIS_HOST is set to 'redis' (service name) in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend Configuration
FRONTEND_PORT=80

# JWT and Session Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-jwt-secret-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# Other Environment Variables
# Add any other environment variables your application needs here
# For example:
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-email-password

